FROM apache/airflow:3.0.2-python3.12

# --- Airflow-side deps (no dbt here anymore) ---
COPY requirements-airflow.txt /requirements-airflow.txt
RUN pip install --no-cache-dir -r /requirements-airflow.txt \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-3.0.2/constraints-3.12.txt"

# --- dbt in its own isolated venv (root, since venv creation needs write access) ---
USER root
RUN python3 -m venv /opt/dbt-venv && \
    /opt/dbt-venv/bin/pip install --no-cache-dir \
        dbt-core==1.11.12 \
        dbt-postgres==1.10.2 \
        dbt-duckdb==1.10.1

# Make dbt callable from PATH without needing the full venv path every time
ENV PATH="/opt/dbt-venv/bin:${PATH}"
USER airflow